# Copy this file to .env.local and fill in your credentials

# Google OAuth — from Google Cloud Console
# https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Google Cloud Vision API — for plant detection in photos
# console.cloud.google.com → Enable "Cloud Vision API" → Credentials → Create API Key
VITE_GOOGLE_VISION_KEY=YOUR_VISION_API_KEY

# Apple Sign In — from Apple Developer portal
# https://developer.apple.com → Certificates, Identifiers & Profiles → Identifiers → Service IDs
VITE_APPLE_CLIENT_ID=com.yourcompany.gardenapp
VITE_APPLE_REDIRECT_URI=https://haimeili.github.io/salescommission/
